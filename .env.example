# ====================================================================
# Configuration & API Keys for Self-Evaluating Lesson Generator
# ====================================================================

# Provider Selection: "gemini" | "openai" | "groq" | "mock"
# Note: "mock" runs the full multi-agent state loop deterministically without API costs!
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Evaluation Hyperparameters
MAX_RETRIES=2
PERSISTENT_MEMORY_PATH=data/memory.json
REJECTION_LOG_PATH=data/rejection_log.json
